    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "socket.io": "^4.8.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^22.14.0",
    "@types/validator": "^13.15.10",
